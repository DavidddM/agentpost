# Public address the other devs will use. Only used to print the join command.
AGENTPOST_PUBLIC_URL=https://agents.example.com

# Port on this machine (localhost only) that the tunnel points at.
# AGENTPOST_HOST_PORT=8765

# Largest single message, in bytes of encoded text.
# AGENTPOST_MAX_MESSAGE_BYTES=16000

# Largest tool reply, in bytes. Keep it under 25000: Claude Code refuses MCP
# tool output above 25,000 tokens, and a token is at least one byte.
# Must be at least 2000 above AGENTPOST_MAX_MESSAGE_BYTES.
# AGENTPOST_MAX_REPLY_BYTES=24000
